# BehaviorSpace and analysis output data (prevent committing large CSVs)
# Store outputs in results/ — small summary files may be committed; large files should not
*-table.csv
*-spreadsheet.csv
/experiments/*.csv
/results/*.csv
/results/*.pdf
/results/*.png
/results/*.svg

# Raw data files larger than ~50 MB should be archived externally (Zenodo/Dryad)
# and linked in data/README.md rather than committed here
/data/raw/*.zip
/data/raw/*.tar.gz

